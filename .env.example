# --- Model provider (OpenAI-compatible) ---
UDACITY_API_KEY=
UDACITY_MODEL_NAME=gpt-4o-mini
UDACITY_BASE_URL=https://openai.vocareum.com/v1

# --- Web research ---
TAVILY_API_KEY=

# --- Bounded resource limits ---
REQUEST_TIMEOUT_SECONDS=30
MAX_SEARCH_RESULTS=5
MAX_PAGES_TO_SCRAPE=3
MAX_PAGE_CHARACTERS=20000
MAX_AGENT_REVISIONS=1
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70

# --- Agent execution budgets ---
MAX_AGENT_STEPS=12
MAX_ORCHESTRATOR_STEPS=16
MAX_TOTAL_TOOL_CALLS=40
MAX_CALLS_PER_TOOL=6

# --- Human in the loop ---
# When true, a restricted action (refund, policy exception, account compromise)
# pauses for a human decision. Denial is the default when no operator is attached.
SUPPORTSCOUT_REQUIRE_APPROVAL=true
# Approve restricted actions without prompting. CI and testing only.
SUPPORTSCOUT_AUTO_APPROVE=false

# --- Paths ---
OUTPUT_DIRECTORY=output
LOG_DIRECTORY=logs
CACHE_DIRECTORY=.cache

# --- Synthetic operations service ---
SUPPORT_DATA_BASE_URL=http://127.0.0.1:8001
